# Actual server connection
ACTUAL_SERVER_URL=https://actual.example.com
ACTUAL_PASSWORD=your-server-password
# Sync ID of the budget file (Settings > Advanced > Sync ID)
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000
# Only if the budget file is end-to-end encrypted
ACTUAL_E2E_PASSWORD=
# Local cache dir for the downloaded budget
ACTUAL_DATA_DIR=./.actual-cache

# Local LLM
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# Tuning
AUTOCAT_LOOKBACK_DAYS=30
AUTOCAT_HISTORY_DAYS=365
AUTOCAT_THRESHOLD=0.8
AUTOCAT_RULE_THRESHOLD=0.9
# History-based shortcut: min occurrences and min share of one category
AUTOCAT_HISTORY_MIN_COUNT=3
AUTOCAT_HISTORY_MIN_SHARE=0.8

# Tagging (only active with --tags / --new-tags)
AUTOCAT_MAX_NEW_TAGS=3
AUTOCAT_NEW_TAG_THRESHOLD=0.9
AUTOCAT_TAG_VOCAB_LIMIT=60
